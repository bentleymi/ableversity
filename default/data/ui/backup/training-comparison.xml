<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--indigo:#4F46E5;--indigo-dark:#3730A3;--green-500:#10B981;--green-600:#059669;--red-500:#EF4444;--yellow-500:#F59E0B;--purple-500:#8B5CF6;--gray-50:#F9FAFB;--gray-100:#F3F4F6;--gray-200:#E5E7EB;--gray-300:#D1D5DB;--gray-400:#9CA3AF;--gray-500:#6B7280;--gray-600:#4B5563;--gray-700:#374151;--gray-800:#1F2937;--gray-900:#111827}
body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;background:#f1f5f9;color:#1e293b;line-height:1.6}
.comparison-header{background:white;border-bottom:2px solid #e2e8f0;padding:20px 24px;display:flex;align-items:center;gap:16px;box-shadow:0 2px 8px rgba(0,0,0,.05)}
.comparison-header h1{font-size:20px;font-weight:700;color:#0f172a}
.comparison-container{max-width:1400px;margin:24px auto;padding:0 20px}
.comparison-table{width:100%;border-collapse:separate;border-spacing:0;background:white;border-radius:16px;overflow:hidden;box-shadow:0 4px 16px rgba(0,0,0,.08)}
.comparison-table th,.comparison-table td{padding:16px 12px;text-align:center;border-bottom:1px solid #f1f5f9;font-size:13px}
.comparison-table th{background:linear-gradient(135deg,#4F46E5 0%,#3730A3 100%);color:white;font-weight:700;font-size:14px;position:sticky;top:0;white-space:nowrap}
.comparison-table th:first-child{background:#f8fafc;color:#475569;text-align:left;font-size:14px;font-weight:600;position:sticky;left:0;min-width:180px}
.comparison-table td:first-child{background:#f8fafc;font-weight:600;color:#374151;text-align:left;min-width:180px}
.ableu-cell{background:#ECFDF5}
.splunk-cell{background:#FEF2F2}
.udemy-cell{background:#FFFBEB}
.thm-cell{background:#F5F3FF}
.ableu-highlight{font-weight:700;color:#059669;font-size:15px}
.splunk-highlight{font-weight:700;color:#991B1B;font-size:15px}
.udemy-highlight{font-weight:700;color:#92400E;font-size:15px}
.thm-highlight{font-weight:700;color:#7C3AED;font-size:15px}
.price-tag{font-size:11px;color:#64748b;margin-top:3px}
.badge{display:inline-block;padding:3px 8px;border-radius:5px;font-size:11px;font-weight:600;margin:3px 2px}
.badge-ableu{background:#10B981;color:white}
.badge-splunk{background:#EF4444;color:white}
.badge-udemy{background:#F59E0B;color:white}
.badge-thm{background:#8B5CF6;color:white}
.check-icon{color:#10B981;font-size:16px}
.cross-icon{color:#EF4444;font-size:16px}
.dot-icon{color:#9CA3AF;font-size:16px}
.comparison-desc{font-size:12px;color:#64748b;line-height:1.5}
.btn-back{display:inline-flex;align-items:center;gap:6px;color:var(--indigo);text-decoration:none;font-weight:600;margin-bottom:16px;font-size:14px}
.btn-back:hover{text-decoration:underline}
@media(max-width:1024px){.comparison-table{display:block;overflow-x:auto}.comparison-table th,.comparison-table td{min-width:200px}}
</style>

